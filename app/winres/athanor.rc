// Windows resources for Athanor.exe: icon + version info.
// Compiled into rsrc_windows_amd64.syso by build.sh / build.cmd (llvm-windres or windres).
1 ICON "athanor.ico"

1 VERSIONINFO
FILEVERSION     2,14,0,0
PRODUCTVERSION  2,14,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "Athanor"
      VALUE "FileVersion",      "2.14.0.0"
      VALUE "InternalName",     "Athanor"
      VALUE "OriginalFilename", "Athanor.exe"
      VALUE "ProductName",      "Athanor"
      VALUE "ProductVersion",   "2.14.0"
      VALUE "LegalCopyright",   "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
