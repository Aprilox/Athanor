# Settings shared by all projects. The app (Athanor.exe → Settings) writes this file for you.
# Otherwise copy it to ".env" and fill in the first line. Never share .env: the token gives access to your Claude subscription.

# Login token (valid 1 year), obtained with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Project lead model: claude-fable-5-1, claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, or the aliases fable, opus, sonnet (empty = account default)
MODEL=
# Fallback model: used automatically when the main model's quota is exhausted, until it reopens (empty = pause). Suggested: claude-opus-5-5 with MODEL=claude-fable-5-1
FALLBACK_MODEL=
# Sub-agents model (empty = same as the lead)
SUBAGENT_MODEL=
# Cheap model for simple, mechanical tasks (sub-agent "executor": long command outputs, searches, bulk edits, file copies); empty = same as the other sub-agents
CHEAP_MODEL=haiku
# Reasoning effort: empty = normal; low, medium, high, xhigh, max
EFFORT=

# Language Claude works and documents in (en, fr, es, de, it, pt); set by the app
LANGUAGE=en
# Safety stop after this many hours (168 = one week)
MAX_HOURS=168
# Wait when the quota reset time cannot be read (minutes)
QUOTA_WAIT_MIN=20
# Watchdog: a cycle is stopped if it stays silent or runs too long (minutes)
IDLE_MAX_MIN=30
CYCLE_MAX_MIN=180
# One milestone per cycle: the cycle is closed shortly after a milestone commit (1 = yes)
CLOSE_AFTER_MILESTONE=1

# Command output compression (1 = on, 0 = off)
RTK=1
# Time zone of the logs (empty = the system time zone), e.g. Europe/Paris, America/New_York
TZ=
# Unreal MCP: 1 = Claude drives the open Unreal editor (default address below)
UNREAL_MCP=0
UNREAL_MCP_URL=http://127.0.0.1:8000/mcp
# PC tool paths, if auto-detection misses them (WSL paths)
# UE_DIR=/mnt/d/Epic Games/UE_5.8
# ANDROID_SDK_DIR=/mnt/c/Users/YOU/AppData/Local/Android/Sdk
# BLENDER_EXE=/mnt/c/Program Files/Blender Foundation/Blender 4.5/blender.exe
