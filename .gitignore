# Secrets and local state: never in the repository (all paths anchored at the root of the tool)
/.env
/tools/
/logs/
# made at run time: what the PC has, Claude's commands (links to the executable), RTK
/system/
/athanor-config.json
/athanor-config-*.json
/_a_supprimer/
/_old-*/
# Skills & MCP library of the app (and API keys of the servers)
/extensions/
__pycache__/
# Legacy single-project layout (projects now live outside the tool)
/projet/
/projet-ancien-*/
# Previous name of the tool (Claude Autopilote)
/autopilote-config.json
/Autopilote.exe
# Binaries: provided in Releases (Windows and Linux side by side in the tool folder)
/Athanor.exe
/athanor
/athanor-linux-*
/app/Athanor.exe
/app/athanor
/dist/
# repairs made on one PC (texts replacing the kit's, see app/remplacables.go)
/local/
