#!/usr/bin/env bash
# Native Windows mode: the real flock when Git Bash has one; otherwise a lock folder next to the locked
# file, held by the calling shell (flock -n FD, flock -w SECONDS FD, flock -u FD, the forms the scripts
# use). A lock whose shell has ended is taken over.
ici=$(cd "$(dirname "$0")" && pwd)
IFS=: read -ra dossiers <<< "$PATH"
for d in "${dossiers[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd)" = "$ici" ] && continue
  for f in "$d/flock" "$d/flock.exe"; do [ -f "$f" ] && [ -x "$f" ] && exec "$f" "$@"; done
done
attente=-1; liberer=0; fd=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--nonblock) attente=0; shift ;;
    -w|--timeout) attente="${2%%.*}"; shift 2 ;;
    -u|--unlock) liberer=1; shift ;;
    -x|-e|--exclusive) shift ;;
    *) fd="$1"; shift; break ;;
  esac
done
[[ "$fd" =~ ^[0-9]+$ ]] || { echo "flock (Athanor, native Windows): only the FD forms are supported" >&2; exit 64; }
proprietaire=$PPID
cible=$(readlink "/proc/$proprietaire/fd/$fd" 2>/dev/null)
[ -n "$cible" ] || exit 0   # nothing open on that descriptor: nothing to lock
dossier="$cible.verrou.d"
if [ "$liberer" = 1 ]; then
  [ "$(cat "$dossier/pid" 2>/dev/null)" = "$proprietaire" ] && rm -rf "$dossier"
  exit 0
fi
debut=$SECONDS
while :; do
  if mkdir "$dossier" 2>/dev/null; then echo "$proprietaire" > "$dossier/pid"; exit 0; fi
  p=$(cat "$dossier/pid" 2>/dev/null)
  [ "$p" = "$proprietaire" ] && exit 0
  if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$dossier"; continue; fi
  [ -z "$p" ] && [ $(( SECONDS - debut )) -ge 2 ] && { rm -rf "$dossier"; continue; }   # half-made by a crash
  [ "$attente" -ge 0 ] && [ $(( SECONDS - debut )) -ge "$attente" ] && exit 1
  sleep 0.5
done
