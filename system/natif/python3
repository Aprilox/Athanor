#!/usr/bin/env bash
# Native Windows mode: python3 is Windows' Python (the py launcher, else python.exe outside the Microsoft
# Store stub). Its text output ends lines with \r\n, which bash would keep in $(...): the \r go.
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
if command -v py.exe >/dev/null 2>&1; then
  p=(py.exe -3)
else
  p=()
  IFS=: read -ra dossiers <<< "$PATH"
  for d in "${dossiers[@]}"; do
    case "$d" in *WindowsApps*) continue ;; esac
    [ -x "$d/python.exe" ] && { p=("$d/python.exe"); break; }
  done
  [ ${#p[@]} -gt 0 ] || { echo "Python for Windows is missing (Setup & health -> Install everything)." >&2; exit 127; }
fi
set -o pipefail
"${p[@]}" "$@" | tr -d '\r'
exit "${PIPESTATUS[0]}"
