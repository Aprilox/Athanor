#!/usr/bin/env bash
# Native Windows mode: "pkill [-SIGNAL] -s PID" (the only form the pilot uses) ends the whole Windows
# process tree of PID (the bash started for Claude, Claude, its tools and the programs they opened).
sig=TERM; sid=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s) sid="${2:-}"; shift 2 ;;
    -[A-Z]*|-[0-9]*) sig="${1#-}"; shift ;;
    *) shift ;;
  esac
done
[[ "$sid" =~ ^[0-9]+$ ]] || exit 1
w=$(cat "/proc/$sid/winpid" 2>/dev/null)
[[ "$w" =~ ^[0-9]+$ ]] || exit 1
taskkill //T //F //PID "$w" >/dev/null 2>&1
kill "-$sig" "$sid" 2>/dev/null
exit 0
