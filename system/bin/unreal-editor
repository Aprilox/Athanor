#!/usr/bin/env bash
# unreal-editor [--wait-mcp] FILE.uproject [ARGUMENTS...]: opens the Unreal editor (window)
# without blocking. With --wait-mcp, waits until its MCP server answers (5 min at most).
. "$(dirname "$0")/_common.sh"
passer_par_le_pont "$@"
exe="${UE_DIR:-}/Engine/Binaries/Win64/UnrealEditor.exe"
[ -f "$exe" ] || absent "Unreal Engine"
attendre=0; [ "${1:-}" = "--wait-mcp" ] && { attendre=1; shift; }
convertir_args "$@"
# Starts the editor's MCP server without manual setup (Unreal MCP plugin enabled in the .uproject).
[ "$attendre" = 1 ] && ARGS+=("-ExecCmds=ModelContextProtocol.StartServer")
lancer_windows --detache "$exe" "${ARGS[@]}"
if [ "$attendre" = 1 ]; then
  url="${UNREAL_MCP_URL:-http://127.0.0.1:8000/mcp}"
  for i in $(seq 1 60); do
    curl -s -o /dev/null --max-time 3 "$url" && { echo "Unreal MCP ready ($url)"; exit 0; }
    sleep 5
  done
  echo "The editor is running but its MCP server is not answering on $url (Unreal MCP plugin enabled? auto-start?)." >&2
  exit 1
fi
echo "Unreal editor started."
