#!/usr/bin/env bash
# blender ARGUMENTS...: the Blender installed on the PC (e.g. blender -b -P tools/scene.py).
# blender --open [FILE.blend]: opens Blender's window (on a .blend of the project), without blocking, on
# Claude's desktop when that option is on; nothing if a Blender already runs (yours included: the Blender
# MCP then drives that one). Its MCP add-on starts its server by itself when "Auto Start" is on.
. "$(dirname "$0")/_common.sh"
passer_par_le_pont "$@"
[ -n "${BLENDER_EXE:-}" ] && [ -f "$BLENDER_EXE" ] || absent Blender
blender_ouvert() {
  (cd /mnt/c 2>/dev/null; MSYS2_ARG_CONV_EXCL='*' tasklist.exe /FI "IMAGENAME eq blender.exe" /NH 2>/dev/null) | grep -qi 'blender.exe'
}
if [ "${1:-}" = "--open" ]; then
  fichier="${2:-}"
  if blender_ouvert; then echo "Blender is already open."; exit 0; fi
  if [ -n "$fichier" ]; then
    case "${fichier,,}" in *.blend) ;; *) echo "Refused: a .blend file only." >&2; exit 2 ;; esac
    [ -f "$fichier" ] || { echo "File not found: $fichier" >&2; exit 2; }
    reel=$(realpath "$fichier")
    case "$reel" in "$(realpath "$PROJECT")/"*) ;; *) echo "Refused: the file must be inside the project ($reel)." >&2; exit 2 ;; esac
    lancer_windows --detache "$BLENDER_EXE" "$(wslpath -w "$reel")"
  else
    lancer_windows --detache "$BLENDER_EXE"
  fi
  for _ in $(seq 1 20); do blender_ouvert && { echo "Blender started."; exit 0; }; sleep 2; done
  echo "Blender did not start." >&2; exit 1
fi
convertir_args "$@"
lancer_windows "$BLENDER_EXE" "${ARGS[@]}"
exit $?
