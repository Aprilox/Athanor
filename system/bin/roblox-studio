#!/usr/bin/env bash
# roblox-studio [--wait] [PLACE.rbxl|PLACE.rbxlx]: opens Roblox Studio (window) on a place of the project,
# without blocking, on Claude's desktop when that option is on. Does nothing if a Studio is already open
# (yours included: its MCP server then drives that one). --wait: returns once Studio runs (1 min at most).
# Rojo project (default.project.json), without PLACE: the project's Studio place, .athanor/studio/NAME.rbxl,
# built from the files when missing.
# roblox-studio --rebuild: Rojo project: closes the Studio of the project, rebuilds its place from the files
# and opens Studio on it again (for what the live sync, .athanor/studio/SYNC.luau, does not carry).
. "$(dirname "$0")/_common.sh"
passer_par_le_pont "$@"
. "$SYSTEME/roblox.sh"
studio_ouvert() { roblox_studio_ouvert; }
attendre=0; reconstruire=0
case "${1:-}" in
  --wait) attendre=1; shift ;;
  --rebuild) reconstruire=1; attendre=1; shift ;;
esac
place="${1:-}"
rojo_f=$(roblox_projet_rojo)
if [ "$reconstruire" = 1 ]; then
  [ -n "$rojo_f" ] || { echo "No Rojo project (default.project.json) here: --rebuild needs one." >&2; exit 2; }
  place=$(roblox_place_studio "$rojo_f")
  n=$(roblox_fermer_projet); [ "${n:-0}" -gt 0 ] 2>/dev/null && { echo "Closed $n Studio window(s) of the project."; sleep 2; }
  rm -f "$place.lock"
  roblox_construire "$rojo_f" "$place" || { echo "rojo build FAILED: the place is not rebuilt." >&2; exit 1; }
  echo "Place rebuilt: ${place#"$PROJECT"/}"
elif [ -z "$place" ] && [ -n "$rojo_f" ]; then
  place=$(roblox_place_studio "$rojo_f")
  if ! studio_ouvert && [ ! -f "$place" ]; then
    roblox_construire "$rojo_f" "$place" || { echo "rojo build FAILED: Studio opens without the place." >&2; place=""; }
  fi
fi
if [ "$reconstruire" = 0 ] && studio_ouvert; then echo "Roblox Studio is already open."; exit 0; fi
# the newest version (Studio updates itself into a new Versions folder)
exe=$(ls -t "${WIN_PROFIL:-/nulle-part}"/AppData/Local/Roblox/Versions/*/RobloxStudioBeta.exe 2>/dev/null | head -n 1)
[ -n "$exe" ] && [ -f "$exe" ] || absent "Roblox Studio"
if [ -n "$place" ]; then
  [ -f "$place" ] || { echo "Place not found: $place" >&2; exit 2; }
  case "${place,,}" in *.rbxl|*.rbxlx) ;; *) echo "Refused: a .rbxl or .rbxlx place only." >&2; exit 2 ;; esac
  reel=$(realpath "$place")
  case "$reel" in "$(realpath "$PROJECT")/"*) ;; *) echo "Refused: the place must be inside the project ($reel)." >&2; exit 2 ;; esac
  lancer_windows --detache "$exe" --task EditFile --localPlaceFile "$(wslpath -w "$reel")"
else
  lancer_windows --detache "$exe"
fi
if [ "$attendre" = 1 ]; then
  for _ in $(seq 1 30); do studio_ouvert && break; sleep 2; done
  studio_ouvert || { echo "Roblox Studio did not start (signed in to Roblox? up to date?)." >&2; exit 1; }
  if [ "$reconstruire" = 1 ]; then
    echo "Roblox Studio started: its MCP server is ready about 30 s later (list_roblox_studios, a new studio_id)."
    exit 0
  fi
  echo "Roblox Studio started."; exit 0
fi
echo "Roblox Studio started."
