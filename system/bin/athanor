#!/usr/bin/env bash
# Claude's AI-free tools (screenshots, map, archive, todo): the kit's executable (athanor in WSL, on Linux
# and macOS, Athanor.exe in native Windows).
K="$(dirname "$0")/../.."
G="$K/athanor"; case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) G="$K/Athanor.exe" ;; esac
case "${1:-}" in
  screenshots|map|archive|todo) ;;
  *) echo "Usage: athanor screenshots|map|archive|todo ..." >&2; exit 2 ;;
esac
[ -x "$G" ] || { echo "athanor: the tool's executable is not reachable here ($G)." >&2; exit 127; }
exec "$G" "$@"
