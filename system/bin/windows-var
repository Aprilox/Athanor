#!/usr/bin/env bash
# windows-var NAME PATH: sets a Windows user environment variable for the development tools
# (ANDROID_HOME, ANDROID_SDK_ROOT, ANDROID_NDK_ROOT, NDKROOT, NDK_ROOT, JAVA_HOME),
# pointing to a folder of $TOOLS/windows or a detected SDK. Windows programs started afterwards see it.
. "$(dirname "$0")/_common.sh"
passer_par_le_pont "$@"
nom="${1:-}"; val="${2:-}"
[[ "$nom" =~ ^(ANDROID_HOME|ANDROID_SDK_ROOT|ANDROID_NDK_ROOT|NDKROOT|NDK_ROOT|JAVA_HOME)$ ]] || { echo "Refused: allowed variables ANDROID_HOME ANDROID_SDK_ROOT ANDROID_NDK_ROOT NDKROOT NDK_ROOT JAVA_HOME" >&2; exit 2; }
[ -d "$val" ] || { echo "Folder not found: $val" >&2; exit 2; }
reel=$(realpath "$val")
case "$reel" in
  "$KIT/tools/windows/"*|"${ANDROID_SDK_DIR:-/nulle-part}"*|"${ANDROID_JDK_DIR:-/nulle-part}"*) ;;
  *) echo "Refused: the path must be inside \$TOOLS/windows or a detected SDK ($reel)." >&2; exit 2 ;;
esac
win=$(wslpath -w "$reel")
powershell.exe -NoProfile -Command "[Environment]::SetEnvironmentVariable('$nom', '$win', 'User')" && echo "$nom=$win (Windows user variable; restart the Unreal editor so it sees it)"
