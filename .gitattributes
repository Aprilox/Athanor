# Line endings are fixed per file type, whatever the contributor's git settings:
# Linux scripts must keep LF (bash in WSL fails on CRLF), Windows scripts keep CRLF.
* text=auto
*.sh        text eol=lf
*.py        text eol=lf
system/bin/* text eol=lf
system/natif/* text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf
*.go        text eol=lf
# Binary files
*.png       binary
*.ico       binary
*.syso      binary
# GitHub language stats: vendored code is not ours
app/third_party/** linguist-vendored
app/tools/*.cs     linguist-vendored
# Not needed in the release zip
.github/           export-ignore
