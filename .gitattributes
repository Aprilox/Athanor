# Line endings are fixed per file type, whatever the contributor's git settings: the sources and texts
# keep LF (the Go tests compare them byte for byte; check.sh scripts Claude writes need it too).
* text=auto
*.go        text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.syso      binary
*.ico       binary
*.png       binary
# GitHub language stats: vendored code is not ours
app/third_party/** linguist-vendored
app/tools/*.cs     linguist-vendored
# Not needed in the release zip
.github/           export-ignore
